# Target application
BASE_URL=https://www.automationexercise.com
BASE_API_URL=https://www.automationexercise.com/api

# Pre-existing test account (used by global setup and login tests)
USERNAME=your_username
EMAIL=your_email@example.com
PASSWORD=your_password

# CI-only credentials (only required when TEST_ENV=ci)
# CI_USER=ci_username
# CI_PASSWORD=ci_password

# Test environment — leave unset for local, set to "ci" in CI pipelines
# TEST_ENV=ci
