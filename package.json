  "devDependencies": {
    "@biomejs/biome": "^2.3.10",
    "@faker-js/faker": "^10.2.0",
    "@playwright/test": "1.57.0",
    "@types/node": "^25.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0"
