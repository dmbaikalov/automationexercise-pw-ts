{
  "name": "automationexercise-pw-ts",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "format": "npx @biomejs/biome format --write",
    "lint": "npx @biomejs/biome lint --write",
    "prepare": "husky",
    "test": "npx playwright test",
    "test:smoke": "npx playwright test --grep @smoke",
    "test:regression": "npx playwright test --grep @regression",
    "test:api": "npx playwright test --project=api",
    "typecheck": "npx tsc --noEmit",
    "allure:env": "tsx scripts/generateAllureEnv.ts",
    "allure:generate": "npm run allure:env && npx allure generate ./allure-results --clean -o ./allure-report",
    "allure:open": "npx allure open ./allure-report",
    "allure:serve": "npm run allure:env && npx allure serve ./allure-results"
  },
  "lint-staged": {
    "*.{ts,tsx,js}": [
      "biome check --write",
      "biome format --write"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dmbaikalov/automationexercise-pw-ts.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/dmbaikalov/automationexercise-pw-ts/issues"
  },
  "homepage": "https://github.com/dmbaikalov/automationexercise-pw-ts#readme",
  "devDependencies": {
    "@biomejs/biome": "^2.3.10",
    "@faker-js/faker": "^10.2.0",
    "@playwright/test": "1.57.0",
    "@types/node": "^25.6.0",
    "allure-commandline": "^2.43.0",
    "allure-playwright": "^3.10.2",
    "dotenv": "^17.2.3",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "tsx": "^4.23.1"
  }
}
